# Root/shared
POSTGRES_DB=cra_compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_ENVIRONMENT=development
BACKEND_API_PREFIX=/api/v1
BACKEND_PROJECT_NAME=CRA Compliance Tool
BACKEND_SECRET_KEY=change-me-in-production
