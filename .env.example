# ============================================================================
# CRANE Environment Configuration
# ============================================================================
# IMPORTANT: For production deployments, you MUST customize all settings marked
# with [REQUIRED]. Leaving defaults in place will compromise security.
# ============================================================================

# Database Configuration
# [REQUIRED] Change POSTGRES_PASSWORD to a strong, random value (min 32 chars)
# Generate: openssl rand -hex 32
POSTGRES_DB=cra_compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# [REQUIRED FOR PRODUCTION] Set to false for production
BACKEND_DEBUG=false
# [REQUIRED FOR PRODUCTION] Set to production for production deployments
BACKEND_ENVIRONMENT=production
BACKEND_API_PREFIX=/api/v1
BACKEND_PROJECT_NAME=CRA Compliance Tool
# [REQUIRED] Generate a strong secret key (min 32 random characters)
# Generate: openssl rand -hex 32
BACKEND_SECRET_KEY=
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
# [REQUIRED] Update the database URL if using an external PostgreSQL instance
# Development: postgresql+psycopg://postgres:PASSWORD@postgres:5432/cra_compliance
# Production (external): postgresql+psycopg://user:password@host:5432/cra_compliance
BACKEND_DATABASE_URL=postgresql+psycopg://postgres:POSTGRES_PASSWORD@postgres:5432/cra_compliance
# [REQUIRED] Configure CORS origins for your frontend domain
# Examples: http://localhost:5173 (dev), https://compliance.example.com (prod)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_LOG_LEVEL=INFO
BACKEND_ADMIN_PASSWORD=admin1234

# Frontend Configuration
VITE_APP_NAME=CRA Compliance Tool
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_REQUEST_TIMEOUT_MS=15000
